/*
 * Apple MacBook Air (13-inch, M5) J813: the NVMe tree plus SMC power off /
 * restart and the watchdog, for a Debian desktop.
 */

#include "t8142-j813-nvme.dts"

/*
 * N1 Wi-Fi/Bluetooth on apcie port 0. The bootloader trains the link (AUS5
 * PHY, refclk buffer, N1 reset, port; see the m5air FINDINGS); Linux uses the
 * root port as a generic ECAM host and owns the DART and the endpoint.
 * Ranges and the DART IRQ from the J813 ADT, as in t8142-j813-wifi.dts.
 */
&{/} {
	pcie0: pcie@1cb0000000 {
		compatible = "pci-host-ecam-generic";
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 1>;
		reg = <0x1c 0xb0000000 0 0x200000>;
		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0 0x20000000>,
			 <0x02000000 0 0x80000000 0xb 0x80000000 0 0x40000000>;
		dma-coherent;
		msi-parent = <&pcie0_msi>;
		/* N1's three ADT mapper nodes use stream zero. */
		iommu-map = <0x100 &dart_apcie0 0 1>,
			    <0x101 &dart_apcie0 0 1>,
			    <0x102 &dart_apcie0 0 1>;
	};
};

&{/soc} {
	/*
	 * Port 0's MSI map (ADT apcie reg[8]). ADT msi-address 0xfffff000,
	 * msi-vector-offset 1741, #msi-vectors 96 for three ports: port 0
	 * owns the first 32.
	 */
	pcie0_msi: msi-controller@488028000 {
		compatible = "apple,t8142-pcie-msi";
		reg = <4 0x88028000 0 0x8000>;
		msi-controller;
		msi-ranges = <&aic AIC_IRQ 1741 IRQ_TYPE_EDGE_RISING 32>;
	};

	dart_apcie0: iommu@488000000 {
		compatible = "apple,t8142-dart", "apple,t8110-dart";
		reg = <4 0x88000000 0 0x20000>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1463 IRQ_TYPE_LEVEL_HIGH>;
		#iommu-cells = <1>;
	};
};

&{/soc} {
	/* ADT /arm-io/wdt (wdt,t8142): restart (and the SMC's fallback). */
	wdt: watchdog@3882b0000 {
		compatible = "apple,t8142-wdt", "apple,t8103-wdt";
		reg = <0x3 0x882b0000 0x0 0x4000>;
		clocks = <&clkref>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 361 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&{/soc} {
	/*
	 * ADT /arm-io/nub-spmi0 (gen 4) and its primary PMU, pmu-main
	 * ("abbey", slave 0xe). The boot flags live in the legacy scratchpad
	 * (info-leg_scrpad = 0xf800), laid out as on T8103 and J873.
	 */
	nub_spmi0: spmi@388714000 {
		compatible = "apple,t8142-spmi";
		reg = <0x3 0x88714000 0x0 0x4000>;
		#address-cells = <2>;
		#size-cells = <0>;

		pmic@e {
			compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
			reg = <0xe SPMI_USID>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				boot_stage: boot-stage@f801 {
					reg = <0xf801 0x1>;
				};

				boot_error_count: boot-error-count@f802,0 {
					reg = <0xf802 0x1>;
					bits = <0 4>;
				};

				panic_count: panic-count@f802,4 {
					reg = <0xf802 0x1>;
					bits = <4 4>;
				};

				/* Set before off1, or the machine powers back on. */
				shutdown_flag: shutdown-flag@f80f,3 {
					reg = <0xf80f 0x1>;
					bits = <3 1>;
				};
			};
		};
	};
};

&smc {
	/* Power off (MBSE = off1) and restart (MBSE = phra). */
	reboot {
		compatible = "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
			      <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage",
				   "boot_error_count", "panic_count";
	};
};
